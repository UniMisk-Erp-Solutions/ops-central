# Test dependencies are installed at the root with --no-save (see docs/testing.md)
node_modules/
frontend/node_modules/
frontend/.env
backend/node_modules/
backend/.env
.env
*.log
.DS_Store

# Claude Code local settings — contains machine-local data (e.g. SSH password). Never commit.
.claude/

# Vercel
.vercel/

# Throwaway diagnostic SQL (underscore-prefixed)
supabase/_*.sql

# Full cluster dump — large (~99MB) AND contains role password hashes. Never commit.
full_cluster.sql
*.dump

# Throwaway diagnostic output from ssh-* scripts
scripts/_*.txt
scripts/_*.out.txt
